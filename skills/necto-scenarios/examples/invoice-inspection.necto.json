{
  "format": "necto-shared-scenario",
  "version": 1,
  "kind": "builder",
  "scenario": {
    "format": "necto-scenario-builder",
    "version": 5,
    "id": "example-invoice-inspection",
    "name": "Inspect an invoice alongside service weather",
    "concurrency": 2,
    "variables": [],
    "connections": [
      {
        "from": "invoice",
        "to": "lines"
      }
    ],
    "steps": [
      {
        "id": "invoice",
        "label": "Find invoice by reference",
        "operationKey": "GET /invoices/by-reference",
        "apiId": "local",
        "method": "GET",
        "path": "/invoices/by-reference",
        "dependsOn": [],
        "inputs": [
          {
            "location": "query",
            "name": "invoiceReference",
            "source": "human",
            "prompt": "Enter the invoice reference to inspect",
            "valueType": "text"
          }
        ],
        "request": {
          "fields": {},
          "body": "",
          "assertions": [
            {
              "kind": "status",
              "expected": "200"
            },
            {
              "kind": "exists",
              "path": "/id"
            }
          ],
          "timeout": 30000,
          "responseLimitMiB": 32
        }
      },
      {
        "id": "weather",
        "label": "Read weather independently",
        "operationKey": "GET /weatherforecast",
        "apiId": "local",
        "method": "GET",
        "path": "/weatherforecast",
        "dependsOn": [],
        "inputs": [],
        "request": {
          "fields": {},
          "body": "",
          "assertions": [
            {
              "kind": "status",
              "expected": "200"
            }
          ],
          "timeout": 30000,
          "responseLimitMiB": 32
        }
      },
      {
        "id": "lines",
        "label": "Read lines of the selected invoice",
        "operationKey": "GET /invoices/{invoiceId}/lines",
        "apiId": "local",
        "method": "GET",
        "path": "/invoices/{invoiceId}/lines",
        "dependsOn": [],
        "inputs": [
          {
            "location": "path",
            "name": "invoiceId",
            "source": "response",
            "stepId": "invoice",
            "responsePointer": "/id"
          }
        ],
        "request": {
          "fields": {},
          "body": "",
          "assertions": [
            {
              "kind": "status",
              "expected": "200"
            }
          ],
          "timeout": 30000,
          "responseLimitMiB": 32
        }
      }
    ]
  }
}
